<?xml version="1.0" encoding="utf-8"?><!--
   Tosse Pay privacy rule: transaction history and payment-operation state
   must never leave the device. android:allowBackup stays enabled so the
   user's non-sensitive preferences (theme, selected bank id) survive a
   reinstall, but the database and payment SharedPreferences are excluded
   from Android Auto Backup.
-->
<full-backup-content>
    <exclude domain="database" path="tossepay_database" />
    <exclude domain="database" path="tossepay_database-shm" />
    <exclude domain="database" path="tossepay_database-wal" />
    <exclude domain="database" path="tossepay_database-journal" />
    <!-- Migration set-aside/temp files: .unreadable can be the ORIGINAL
         PLAINTEXT db (failed encryption migration), so it must never be
         backed up; .encrypting is an encrypted temp. Path matching is exact,
         not prefixed, so these need their own entries. -->
    <exclude domain="database" path="tossepay_database.unreadable" />
    <exclude domain="database" path="tossepay_database.encrypting" />
    <exclude domain="sharedpref" path="payment_operation.xml" />
    <exclude domain="sharedpref" path="tossepay_db_key.xml" />
    <exclude domain="sharedpref" path="TossePayPrefs.xml" />
</full-backup-content>
